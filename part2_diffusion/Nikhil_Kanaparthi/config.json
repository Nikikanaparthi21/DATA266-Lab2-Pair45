{
  "base_model": "runwayml/stable-diffusion-v1-5",
  "dataset": "lambdalabs/naruto-blip-captions",
  "resolution": 512,
  "split": "90/10 with numpy default_rng(266)",
  "train_script": "diffusers v0.31.0 examples/text_to_image/train_text_to_image_lora.py",
  "train_batch_size": 1,
  "gradient_accumulation_steps": 4,
  "effective_batch_size": 4,
  "learning_rate": 0.0001,
  "max_train_steps": 1000,
  "mixed_precision": "fp16",
  "gradient_checkpointing": true,
  "checkpointing_steps": 250,
  "runs": {
    "run1": {
      "rank": 4,
      "dir": "lora_rank4"
    },
    "run2": {
      "rank": 16,
      "dir": "lora_rank16"
    }
  },
  "sampler": {
    "num_inference_steps": 30,
    "guidance_scale": 7.5,
    "seeds": [
      0,
      1
    ]
  },
  "seed": 266,
  "nsfw_filter": "diffusers StableDiffusionSafetyChecker (default, returns black image)"
}
