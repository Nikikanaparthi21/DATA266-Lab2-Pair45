{
  "notebook": "notebooks/p1_rag.ipynb",
  "environment": {
    "python": "3.10.13",
    "torch": "2.7.0+cu128",
    "gpu": "NVIDIA GeForce RTX 5090",
    "seed": 266
  },
  "config": {
    "seed": 266,
    "embedding_model": "BAAI/bge-small-en-v1.5",
